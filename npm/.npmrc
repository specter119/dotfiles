{{#if dotter.packages.enterprise-artifact}}
# Keep shared registry config here for nodejs consumers; Bun uses the deployed ~/.bunfig.toml.
registry=https://{{enterprise-artifact.npm_registry}}/
//{{enterprise-artifact.npm_registry}}/:_auth={{replace (command_output (replace (replace "printf '%s:%s' '__USER_ID__' '__ACCESS_TOKEN__' | base64" "__USER_ID__" enterprise-artifact.user_id) "__ACCESS_TOKEN__" enterprise-artifact.access_token)) "\n" ""}}
{{/if}}

prefix = ~/.local
