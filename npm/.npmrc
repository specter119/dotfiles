{{#if nodejs.registry}}
# Keep shared registry config here for nodejs consumers; Bun uses the deployed ~/.bunfig.toml.
registry=https://{{nodejs.registry}}/
{{#if registry-auth}}
//{{nodejs.registry}}/:_auth={{replace (command_output (replace (replace "printf '%s:%s' '__USER_ID__' '__ACCESS_TOKEN__' | base64" "__USER_ID__" registry-auth.user_id) "__ACCESS_TOKEN__" registry-auth.access_token)) "\n" ""}}
{{/if}}
always-auth=true
{{else}}
registry=https://registry.npmmirror.com
{{/if}}

prefix = ~/.local
