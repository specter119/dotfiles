{{#if nodejs.registry}}
# Keep shared registry config here for nodejs consumers; Bun uses the deployed ~/.bunfig.toml.
registry=https://{{nodejs.registry}}/
# Auth comes from $XDG_RUNTIME_DIR/dotter/registry-auth-encode, written by .dotter/pre_deploy.sh from registry-auth credentials.
//{{nodejs.registry}}/:_auth={{command_output "cat \"$XDG_RUNTIME_DIR\"/dotter/registry-auth-encode"}}
always-auth=true
{{else}}
registry=https://registry.npmmirror.com
{{/if}}

prefix = ~/.local
