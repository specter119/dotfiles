#!/bin/bash
# Pi npm command wrapper: translates npm-style calls to bun equivalents.
# Logs all invocations for debugging; remove LOG line to disable.
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/pi/npm-command.log"
mkdir -p "$(dirname "$LOG")"
echo "[$(date -Iseconds)] PWD=$PWD args=$*" >> "$LOG"

# Handle 'root -g' command: return bun's global node_modules path
if [[ "$1" == "root" && "$2" == "-g" ]]; then
  echo "${BUN_INSTALL_GLOBAL_DIR:-${HOME}/.bun/install/global}/node_modules"
  exit 0
fi

# Handle 'view' command: delegate to npm for version queries
if [[ "$1" == "view" ]]; then
  exec npm "$@"
fi

# Normalize npm lockfile 'resolved' URLs to the configured mirror origin.
# Bun honours `resolved` URLs from a migrated package-lock.json verbatim,
# bypassing the [install.registry] mirror in ~/.bunfig.toml. Upstream git
# extension repos track npm lockfiles whose resolved URLs point at
# registry.npmjs.org, which is unreachable on this network, so bun fails with
# ConnectionClosed. Rewriting only the origin keeps the upstream version pins
# and integrity hashes while sending downloads through the mirror (the npm
# path layout is registry-agnostic, and the mirror accepts both encodings of
# scoped names). Idempotent: no-op when no foreign host is present.
sanitize_npm_lockfile() {
  local dir="$1" lockfile mirror mirror_host
  lockfile="$dir/package-lock.json"
  [[ -f "$lockfile" ]] || return 0

  # Same mirror source as the rendered ~/.bunfig.toml [install.registry].
  mirror=$(sed -n 's/^url = "\([^"]*\)"/\1/p' "${HOME}/.bunfig.toml" 2>/dev/null | tail -1)
  [[ -n "$mirror" ]] || return 0
  mirror_host=$(printf '%s' "$mirror" | sed -E 's|^https?://([^/]+).*|\1|')
  [[ -n "$mirror_host" ]] || return 0

  if grep -Pq "\"resolved\": \"https?://(?!${mirror_host})[^/\"]+/" "$lockfile"; then
    mirror="${mirror%/}"
    perl -i -pe 's{"resolved": "https?://[^"/]+/}{"resolved": "'"$mirror"'/}g' "$lockfile"
    printf '[pi-npm-bun] redirected "resolved" URLs in %s to %s\n' "$lockfile" "$mirror" >&2
  fi
  return 0
}

args=()
prefix_dir=""
is_install=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    install|add|i)
      args+=("$1" "--trust")
      is_install=true
      shift
      ;;
    --prefix)
      prefix_dir="$2"
      shift 2
      ;;
    --prefix=*)
      prefix_dir="${1#--prefix=}"
      shift
      ;;
    --save|--save-dev|--save-optional|--legacy-peer-deps|--ignore-scripts)
      # npm-only flags bun ignores or handles differently; skip
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$prefix_dir" ]]; then
  cd "$prefix_dir" || exit 1
fi

# Auto-trust blocked lifecycle scripts (postinstall etc.) for pi-managed installs.
# Bun blocks lifecycle scripts by default; `--trust` only records named packages
# added via `bun add`, not transitive deps of a bare `bun install`. `bun pm trust
# --all` runs any still-blocked scripts and records them in package.json.
# This is pi-scoped (this wrapper IS pi's npm command), not a global trust.
# pi wipes git extension repos with `git reset --hard` + `git clean -fdx` on each
# update, so the recorded trustedDependencies are ephemeral and re-applied every
# install — idempotent and safe.
if [[ "$is_install" == true ]]; then
  sanitize_npm_lockfile "$PWD"
  bun "${args[@]}"
  rc=$?
  if [[ $rc -eq 0 ]]; then
    trust_out=$(bun pm trust --all 2>&1)
    # Only surface output when scripts actually ran; suppress the noisy "0 scripts ran" case.
    if [[ "$trust_out" == *"scripts ran across"* ]]; then
      printf '%s\n' "$trust_out" >&2
    fi
  fi
  exit $rc
fi

exec bun "${args[@]}"
