{
  "compaction": {
    "enabled": true
  },
  "defaultModel": "{{pi.default_model}}",
  "defaultProvider": "{{pi.default_provider}}",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "hideThinkingBlock": false,
  "lastChangelogVersion": "{{pi.last_changelog_version}}",
  "npmCommand": [
    "{{env_var "PI_CODING_AGENT_DIR"}}/bin/pi-npm-bun"
  ],
# {{#if agent.otel_url}}
  "otel": {
    "enabled": true,
    "endpoint": "{{agent.otel_url}}",
    "protocol": "http/protobuf",
    "headers": {
      "x-project-name": "harness-pi"
    },
    "serviceName": "pi",
    "captureContent": "metadata_only",
    "sampleRatio": 1,
    "signals": {
      "traces": true,
      "metrics": false,
      "logs": false
    }
  },
# {{/if}}
  "packages": [
    "https://github.com/aliou/pi-guardrails",
    "npm:@narumitw/pi-goal",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "https://github.com/davebcn87/pi-autoresearch",
    "npm:pi-otel"{{#each pi.enterprise_packages}},
    "{{this}}"{{/each}},
    "https://github.com/specter119/bole.git"
  ],
  "theme": "dark",
  "extensionChangelogVersions": {
    "{\"source\":\"https://github.com/aliou/pi-guardrails\",\"scope\":\"user\"}": "0.22.0",
    "{\"source\":\"npm:@tintinweb/pi-subagents\",\"scope\":\"user\"}": "0.23.1",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"https://github.com/davebcn87/pi-autoresearch\",\"scope\":\"user\"}": "1.9.0",
    "{\"source\":\"npm:@narumitw/pi-goal\",\"scope\":\"user\"}": "0.54.15"
  }
}
