{
  "mcpServers": {
# {{#if agent.magpie_apikey}}
    "magpie": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:3425/mcp/magpie/hub",
      "headers": {
        "Authorization": "Bearer {{agent.magpie_apikey}}"
      }
    },
# {{/if}}
    "sequentialthinking": {
      "alwaysAllow": [
        "sequentialthinking"
      ],
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "bunx"
    }
  }
}
