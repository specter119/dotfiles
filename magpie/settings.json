{
  "theme": "system",
  "lang": "system",
  "tray": "panel",
  "currency": "usd",
  "dockNever": true,
  "dockSettled": true,{{#if enterprise_proxy.url}}
  "proxy": "{{url_userinfo_escape enterprise_proxy.url}}",
  "proxyCustom": "{{url_userinfo_escape enterprise_proxy.url}}",{{/if}}
  "otel": {},
  "redactPersonal": true,
  "gatewayConversations": true,
  "sessionReads": {
    "asked": true,
    "all": true,
    "agents": {
      "grok": true
    }
  },
  "updateEvery": 360,
  "trayUsageEvery": 3,{{#if magpie.plugin_proxy}}
  "pluginProxy": "{{magpie.plugin_proxy}}",{{/if}}{{#if magpie.checkin_at}}
  "checkinAt": "{{magpie.checkin_at}}",{{/if}}{{#if magpie.checkin_plugins}}
  "pluginCheckins": { {{#each magpie.checkin_plugins}}"{{this}}": true{{#unless @last}}, {{/unless}}{{/each}} },{{/if}}
  "plainNames": true,
  "guideHidden": true,
  "textSize": 110{{#if magpie.model_wires}},
  "modelWires": { {{~#each magpie.model_wires}}
    "{{@key}}": "{{this}}"{{#unless @last}},{{/unless}}{{/each}}
  }{{/if}}
}
