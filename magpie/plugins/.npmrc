# Bun (plugin installs) and magpie's own npm lookups both read this file.
# magpie takes the token only from an .npmrc _authToken line, never from bunfig.
{{#if dotter.packages.enterprise-artifact}}
registry=https://{{enterprise-artifact.npm_registry}}/
//{{enterprise-artifact.npm_registry}}/:_authToken={{enterprise-artifact.access_token}}
{{/if}}
