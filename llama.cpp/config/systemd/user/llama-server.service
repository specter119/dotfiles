[Unit]
Description=llama-server — Inkling-2-Mini UD-Q4_K_XL on RTX PRO 4500 Blackwell (32 GB)
# binary and model auto-download run in ExecStartPre, both need network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ensure the pinned prebuilt and the GGUFs are present; both scripts are offline
# no-ops once installed (aria2c downloads only what is missing).
ExecStartPre=%h/.local/share/llama-server/llama-cpp-install.sh ensure
ExecStartPre=%h/.local/share/llama-server/model-sync.sh ensure
# The prebuilt lives at ~/.local/opt/llama.cpp/current with the NVIDIA runtime
# libs unpacked beside it (no Nix, no CUDA toolkit): llama-server loads
# libcudart/libcublas from its own directory via $ORIGIN, and libcuda.so.1 comes
# from the WSL driver mount. Single GPU: no --split-mode / --tensor-split.
#
# No --model-draft: DSpark measured *slower* than no speculation on this card
# (71.6 vs 91.7 t/s median, 8 cold prompts, A/B/A). ngram-mod is used instead —
# it ties at cold start and is 13% faster at depth, and costs no VRAM because it
# has no weights. See README "Measured on this card".
#
# --reasoning-effort low: the model's chat template defaults to "Thinking effort
# level: 0.9" when a client sends no reasoning_effort. On a personal-agent style
# question that default spent 1068 tokens / 12.1 s where "low" spent 354 / 3.7 s
# for a better-targeted answer. "low" is the server default here, not a cap: a
# client that sends reasoning_effort (or chat_template_kwargs) still overrides it
# per request, and "max" remains reachable via the API.
ExecStart=%h/.local/opt/llama.cpp/current/llama-server \
    --model %h/.cache/huggingface/hub/models--unsloth--Inkling-2-Mini-GGUF/Inkling-2-Mini-UD-Q4_K_XL.gguf \
    --mmproj %h/.cache/huggingface/hub/models--unsloth--Inkling-2-Mini-GGUF/mmproj-F16.gguf \
    --host 0.0.0.0 \
    --port 8080 \
    --n-gpu-layers all \
    --ctx-size 262144 \
    --parallel 2 \
    --kv-unified \
    --flash-attn on \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --batch-size 2048 \
    --ubatch-size 1024 \
    --spec-type ngram-mod \
    --spec-ngram-mod-n-min 8 \
    --spec-ngram-mod-n-max 16 \
    --cache-ram -1 \
    --ctx-checkpoints 16 \
    --metrics \
    --jinja \
    --reasoning-effort low \
    --temp 1.0 \
    --top-p 1.0 \
    --top-k 0 \
    --min-p 0.0 \
    --image-max-tokens 4000
Restart=on-failure
RestartSec=10
# generous: first start may download the 17.6 GB model and a ~440 MB prebuilt,
# and a cold load of 17.6 GB of weights plus a 256K KV pool is not fast either
TimeoutStartSec=1800
Environment=HF_ENDPOINT=https://hf-mirror.com

[Install]
WantedBy=default.target
