#!/bin/sh

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
lock_file="$runtime_dir/swaylock.lock"

(
	flock -n 9 || exit 0
	# Detach once locked so swayidle -w can resume, while the inherited flock
	# descriptor keeps this lock held in the daemonized process.
	exec swaylock -f
) 9>"$lock_file"
