{
  "$schema": "https://opencode.ai/config.json",
{{#if opencode.default_model}}
  "model": "{{opencode.default_model}}",
{{/if}}
  "mcp": {
{{#if agent.magpie_apikey}}
    "magpie": {
      "type": "remote",
      "url": "http://127.0.0.1:3425/mcp/magpie/hub",
      "headers": {
        "Authorization": "Bearer {{agent.magpie_apikey}}"
      }
    },
{{/if}}
    "fast-context": {
      "type": "local",
      "command": [
        "bunx",
        "fast-context-mcp"
      ],
      "environment": {
        "WINDSURF_API_KEY": "{{replace (command_output 'rbw get windsurf-api-key') '\n' ''}}"
      }
    }
  },
  "permission": {
    "bash": {
      "rbw get*": "deny"
    }
  },
  "plugin": []
}
