#!/bin/sh
# Handles one control connection from voxtype-wsl-bridge.socket (systemd runs this per
# connection with the socket on stdin/stdout). The Windows AutoHotkey script sends
# one of the commands below; anything else is ignored, so the loopback port cannot
# run arbitrary voxtype subcommands.
read -r cmd
case "$cmd" in
start | stop) voxtype record "$cmd" --clipboard ;;
cancel) voxtype record cancel ;;
*) exit 1 ;;
esac
echo ok
