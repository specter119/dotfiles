{
  "amp.mcpServers": {
# {{#if agent.magpie_apikey}}
    "magpie": {
      "headers": {
        "Authorization": "Bearer {{agent.magpie_apikey}}"
      },
      "url": "http://127.0.0.1:3425/mcp/magpie/hub"
    },
# {{/if}}
    "fast-context": {
      "args": [
        "fast-context-mcp"
      ],
      "command": "bunx",
      "environment": {
        "WINDSURF_API_KEY": "{{replace (command_output 'rbw get windsurf-api-key') '\n' ''}}"
      },
      "includeTools": ["fast_context_search"]
    }
  },
  "amp.permissions": [
    {
      "action": "reject",
      "matches": {
        "cmd": "*rbw get*"
      },
      "tool": "Bash"
    }
  ]
}
