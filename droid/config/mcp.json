{
  "mcpServers": {
    "magpie": {
      "type": "http",
      "url": "http://127.0.0.1:3425/mcp/magpie/hub",
      "headers": {
        "Authorization": "Bearer ${MAGPIE_API_KEY}"
      },
      "oauth": false
    },
    "trello": {
      "type": "http",
      "url": "https://mcp.trello.com/v1"
    },{{#if dotter.packages.wsl-guest}}
    "onenote": {
      "type": "stdio",
      "command": "deskhand",
      "args": ["onenote"]
    },
    "kaze": {
      "type": "stdio",
      "command": "kaze-mcp"
    },{{/if}}
    "fast-context": {
      "type": "stdio",
      "command": "bun",
      "args": ["x", "fast-context-mcp"],
      "env": {
        "WINDSURF_API_KEY": "{{replace (command_output "rbw get windsurf-api-key") "\n" ""}}"
      },
      "tools": ["fast_context_search"]
    }
  }
}
