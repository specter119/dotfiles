[Unit]
Description=Multica Agent Runtime Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=multica config set server_url {{multica.server_url}}
ExecStartPre=multica config set app_url {{multica.app_url}}
ExecStart=multica daemon start --foreground
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
