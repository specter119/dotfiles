#!/bin/sh
# Expose Kaze's BrowserMCP bridge to Linux clients. Kaze is a Windows process,
# so ELECTRON_RUN_AS_NODE and KAZE_APP cross the WSL boundary through WSLENV.
# Paths come from wsl-guest's WIN_SCOOP_PATH / WSL_SCOOP_PATH / WIN_HOME.
cd /mnt/c || exit 1
[ -n "$WIN_SCOOP_PATH" ] && [ -n "$WSL_SCOOP_PATH" ] && [ -n "$WIN_HOME" ] || exit 1

kaze_app="$WIN_SCOOP_PATH\\apps\\kaze\\current\\Kaze.exe"
kaze_bridge="$WIN_HOME\\AppData\\Roaming\\Kite\\browsermcp\\bridge.mjs"

export WSLENV="ELECTRON_RUN_AS_NODE:KAZE_APP/p${WSLENV:+:$WSLENV}"
export ELECTRON_RUN_AS_NODE=1
export KAZE_APP="$kaze_app"
exec "$WSL_SCOOP_PATH/apps/kaze/current/Kaze.exe" "$kaze_bridge" "$@"
