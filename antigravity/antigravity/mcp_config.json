{
  "mcpServers": {
{{#if agent.magpie_apikey}}
    "magpie": {
      "serverUrl": "http://127.0.0.1:3425/mcp/magpie/hub",
      "headers": {
        "Authorization": "Bearer {{agent.magpie_apikey}}"
      }
    },
{{/if}}
    "fast-context": {
      "command": "bunx",
      "args": [
        "fast-context-mcp"
      ],
      "includeTools": [
        "fast_context_search"
      ],
      "env": {
        "WINDSURF_API_KEY": "{{replace (command_output 'rbw get windsurf-api-key') '\n' ''}}"
      }
    }
  }
}
